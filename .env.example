# ─── Inbound auth from Eesa ──────────────────────────────────────────────────
# HMAC signing secret — the SAME value set on the platform's
# MCPServerConnection.signing_secret. Recommended for production; paste it into
# the publishing UI "Plugin env".
#   generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MCP_SIGNING_SECRET=

# OR the shared gateway secret (injected automatically by the Eesa publishing
# pipeline for gateway-only plugins). Leave blank if you use MCP_SIGNING_SECRET.
PLUGIN_GATEWAY_SECRET=

# ─── Dialpad ─────────────────────────────────────────────────────────────────
# There is NO global Dialpad key here — this plugin is MULTI-TENANT. Each
# workspace enters its OWN Dialpad API key when it subscribes; the platform
# forwards it per request as the X-Mcp-Tenant-Cred-Api-Key header. This service
# never stores it.

PORT=8080
