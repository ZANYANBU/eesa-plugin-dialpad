# ─── Eesa platform auth ──────────────────────────────────────────────────────
# INJECTED AUTOMATICALLY by the platform when you onboard via the Eesa
# publishing UI. You do NOT set these yourself in production — they're here only
# so the service runs locally.
EESA_JWKS_URL=https://eesa.ai/.well-known/jwks.json
EESA_TOKEN_ISSUER=eesa
PLUGIN_GATEWAY_SECRET=

# ─── Dialpad ─────────────────────────────────────────────────────────────────
# The ONE secret you provide. In production paste it into the Eesa publishing UI
# → "Plugin env" as  DIALPAD_API_KEY=...  — never commit the real value here.
DIALPAD_API_KEY=
# Optional override; defaults to the working Dialpad base below.
DIALPAD_API_BASE=https://dialpad.com/api/v2

PORT=8080
