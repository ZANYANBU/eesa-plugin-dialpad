{
  "manifestVersion": "1.0",
  "slug": "dialpad",
  "name": "Dialpad",
  "version": "2.0.0",
  "description": "Dialpad cloud phone system as agent tools — the complete READ-ONLY surface of the official Dialpad Platform API v1.0 (102 GET endpoints: calls, transcripts, AI recaps, users, contacts, offices, departments, call centers, coaching teams, numbers, rooms, channels, meetings, analytics/stats/scorecards/WFM, and more). Multi-tenant: each workspace connects its own Dialpad API key. No writes.",
  "icon": "",
  "hostedBy": "self",
  "developer": {
    "name": "ZANYANBU",
    "email": "team@eesa.ai"
  },
  "auth": {
    "verify": "mcp-signature",
    "signingSecretEnv": "MCP_SIGNING_SECRET",
    "gatewayOnly": true
  },
  "scopes": [
    "dialpad:read"
  ],
  "tenantConfig": {
    "description": "Per-tenant credentials each workspace enters when it subscribes. The platform stores them on the tenant's Subscription and forwards them per-request as X-Mcp-Tenant-Cred-<Field> headers (api_key -> X-Mcp-Tenant-Cred-Api-Key). Nothing is shared across tenants.",
    "schema": {
      "type": "object",
      "properties": {
        "api_key": {
          "type": "string",
          "title": "Dialpad API key",
          "secret": true,
          "description": "Company API key from Dialpad → Admin Settings → Company Settings → API keys. Auth is Authorization: Bearer <key>."
        },
        "api_base": {
          "type": "string",
          "title": "Dialpad API base URL",
          "description": "Optional. Defaults to https://dialpad.com/api/v2."
        }
      },
      "required": [
        "api_key"
      ]
    }
  },
  "surfaces": {
    "ui": {
      "url": "https://dialpad.plugins.bibekpoudel.com/app",
      "embeddable": true,
      "description": "Conversation history — browse calls, read transcripts and AI recaps. Read-only; fetches through Eesa's gateway (which injects the tenant's Dialpad key), so the UI never holds a credential."
    },
    "mcp": {
      "endpoint": "https://dialpad.plugins.bibekpoudel.com/mcp",
      "transport": "streamable-http",
